# ---- FinFlash backend configuration ----

# App
FINFLASH_ENV=development           # development | production | testing
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# Require an X-API-Key on /api routes. Unset = ON only in production.
# Leave OFF for local/self-host; set true to gate a PUBLIC deployment.
REQUIRE_API_KEY=false

# CORS (comma-separated origins; "*" only for local dev)
CORS_ORIGINS=http://localhost:5173

# Database (async drivers)
# Postgres + pgvector recommended for RAG; SQLite works for local dev (no vector search).
DATABASE_URL=postgresql+asyncpg://finflash:finflash@localhost:5432/finflash
# DATABASE_URL=sqlite+aiosqlite:///./financial_news.db

# Redis (rate limiting + per-key quota)
REDIS_URL=redis://localhost:6379/0

# ---- Default server-side LLM keys (optional) ----
# Used only when a request does NOT bring its own key (BYO key).
# Leave blank to force every caller to supply X-LLM-Key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ---- Self-hosted Ollama (optional; free, no key) ----
# Set this to use local models, then point DEFAULT_LLM_MODEL / DEFAULT_EMBEDDING_MODEL
# at ollama_chat/<model> and ollama/<embed-model>. Callers can also override per-request
# with the X-LLM-Api-Base header.
OLLAMA_API_BASE=
# Cap concurrent LLM calls (0 = unlimited). Set to 1 for a small/constrained
# self-hosted Ollama so the parallel analysts don't crash the model runner.
LLM_MAX_CONCURRENCY=0

# Default model when caller does not specify one (LiteLLM model id).
# Cloud example: openai/gpt-5    Local example: ollama_chat/qwen3.6:latest
DEFAULT_LLM_MODEL=openai/gpt-5

# Embeddings are a DEPLOYMENT-level setting (consistent vector dimension for all rows).
# Cloud: openai/text-embedding-3-small (1536) | gemini/text-embedding-004 (768)
# Local: ollama/embeddinggemma:latest (768)
DEFAULT_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536      # MUST match DEFAULT_EMBEDDING_MODEL's width

TRANSCRIPTION_MODEL=openai/gpt-4o-transcribe

# News search: leave blank to use the FREE Google News RSS source (no key needed).
# Set an Exa key to upgrade to full-text search.
EXA_API_KEY=

# Per-API-key daily quotas (0 = unlimited)
QUOTA_DAILY_REQUESTS=500
QUOTA_DAILY_USD=10.0

# Observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finflash
